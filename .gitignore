# Ignore everything in bios/
bios/*

# But do not ignore the .keep file
!bios/.keep

# The old settings file, which may hold a password: never commit it
config/config.yml

# uv virtual environment
.venv/

# Python and tool caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build output (stage 10)
dist/
build/
