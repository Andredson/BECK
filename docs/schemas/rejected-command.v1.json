{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Andredson/BECK/main/docs/schemas/rejected-command.v1.json",
  "title": "Result of a command line beck --json rejected",
  "description": "No command ran, so command is null and there are only these fields. See docs/json-output.md.",
  "type": "object",
  "required": [
    "schema_version",
    "beck_version",
    "command",
    "ok",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "beck_version": {
      "type": "string"
    },
    "command": {
      "const": null
    },
    "ok": {
      "const": false
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "item"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "usage, config, transport, report_not_found, report_parse, internal, size_mismatch, delete_failed or unsafe_path. New codes may be added."
        },
        "message": {
          "type": "string"
        },
        "item": {
          "type": [
            "string",
            "null"
          ],
          "description": "The target, folder or local file this is about. Null for an error that stopped the run."
        }
      }
    }
  }
}
