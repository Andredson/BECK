# https://editorconfig.org — editor settings shared by humans and agents.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

# uv writes pyproject.toml arrays with 4 spaces, so TOML follows it.
[*.toml]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
